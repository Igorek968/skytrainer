www.{$APP_DOMAIN} {
  redir https://{$APP_DOMAIN}{uri} permanent
}

{$APP_DOMAIN} {
  encode zstd gzip

  # Legacy personal docs must not be world-readable
  @legacySensitive {
    path /uploads/compliance/* /uploads/npd-receipts/*
  }
  respond @legacySensitive 404

  # Optional QA gate (Basic Auth).
  # 1) Generate hash:
  #    docker run --rm caddy:2-alpine caddy hash-password --plaintext "YourStrongPassword"
  # 2) Uncomment next line and replace login/hash:
  # basicauth /* {
  #   qa_tester $2a$14$replace_with_generated_hash
  # }

  reverse_proxy skiinstruct:3000

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Frame-Options "DENY"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
}
