# Public domain for QA stand (required for HTTPS Caddyfile, no protocol)
APP_DOMAIN=utrainer.ru
APP_PUBLIC_URL=https://utrainer.ru
CADDYFILE=Caddyfile
# Для IP без TLS: APP_PUBLIC_URL=http://YOUR_IP и CADDYFILE=Caddyfile.http

# PostgreSQL
POSTGRES_USER=sky
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=skytrainer_new
SKIINSTRUCT_DATABASE_URL=postgres://sky:change-me-strong-password@postgres:5432/skytrainer_new?schema=skiinstruct

# App security
SKIINSTRUCT_AUTH_SECRET=replace-with-random-string-min-32-chars
SKIINSTRUCT_CRON_SECRET=replace-with-random-string-min-32-chars
ALLOW_MOCK_CHECKOUT=0
REQUIRE_EMAIL_VERIFICATION=1
YOOKASSA_WEBHOOK_VERIFY_IP=1
TRUSTED_PROXY_COUNT=1
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
SMS_OTP_DEBUG=0
TELEGRAM_WEBHOOK_SECRET=replace-with-random-string-min-32-chars

# Default admin account created on container start
SKIINSTRUCT_ADMIN_EMAIL=admin@qa.local
SKIINSTRUCT_ADMIN_PASSWORD=ChangeMe12345!
SKIINSTRUCT_ADMIN_NAME=QA Администратор

# Optional integrations
SKIINSTRUCT_AUTH_GOOGLE_ID=
SKIINSTRUCT_AUTH_GOOGLE_SECRET=
SKIINSTRUCT_STRIPE_SECRET_KEY=
SKIINSTRUCT_STRIPE_WEBHOOK_SECRET=
SKIINSTRUCT_VAPID_PUBLIC_KEY=
SKIINSTRUCT_VAPID_PRIVATE_KEY=
SKIINSTRUCT_VAPID_SUBJECT=mailto:you@example.com

# Optional extra origins for server actions. Comma-separated host[:port] values.
SKIINSTRUCT_SERVER_ACTIONS_ALLOWED_ORIGINS=qa.example.com

# Сброс пароля (SMTP Beget)
SKIINSTRUCT_PASSWORD_RESET_DEBUG=0
SKIINSTRUCT_SMTP_HOST=smtp.beget.com
SKIINSTRUCT_SMTP_PORT=465
SKIINSTRUCT_SMTP_SECURE=1
SKIINSTRUCT_SMTP_USER=noreply@utrainer.ru
SKIINSTRUCT_SMTP_PASSWORD=
SKIINSTRUCT_PASSWORD_RESET_EMAIL_FROM="uTrainer <noreply@utrainer.ru>"
SKIINSTRUCT_PASSWORD_RESET_EMAIL_SUBJECT="uTrainer: восстановление пароля"

# Яндекс.Карты и геокодер на /client (ключ нужен при docker build — см. docker-compose.qa.yml)
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
