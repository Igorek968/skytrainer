# Public domain for QA stand (required for HTTPS Caddyfile, no protocol)
APP_DOMAIN=твойтренер.рф
APP_PUBLIC_URL=https://твойтренер.рф
CADDYFILE=Caddyfile
# Для IP без TLS: APP_PUBLIC_URL=http://YOUR_IP и CADDYFILE=Caddyfile.http

# PostgreSQL
POSTGRES_USER=sky
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=skytrainer_new
SKIINSTRUCT_DATABASE_URL=postgres://sky:change-me-strong-password@postgres:5432/skytrainer_new?schema=skiinstruct

# App security
SKIINSTRUCT_AUTH_SECRET=replace-with-random-string-min-32-chars
SKIINSTRUCT_CRON_SECRET=replace-with-random-string-min-32-chars
# 1 — тестовая оплата без ЮKassa (прогон заказа на VPS); 0 — реальные платежи
ALLOW_MOCK_CHECKOUT=1
REQUIRE_EMAIL_VERIFICATION=1
YOOKASSA_WEBHOOK_VERIFY_IP=1
TRUSTED_PROXY_COUNT=1
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Куда слать заполненные агентские договоры при регистрации инструктора
YOOKASSA_DOCS_EMAIL=tvoitrenerrf@yandex.ru
ADMIN_ALERT_EMAIL=tvoitrenerrf@yandex.ru
MAX_BOT_TOKEN=
MAX_SUPPORT_USER_ID=
MAX_SUPPORT_CHAT_ID=
MAX_WEBHOOK_SECRET=replace-with-random-string-A-Za-z0-9_-
NEXT_PUBLIC_SUPPORT_MAX_URL=https://max.ru/id110116757261_bot
NEXT_PUBLIC_SUPPORT_EMAIL=tvoitrenerrf@yandex.ru
NEXT_PUBLIC_SUPPORT_TELEGRAM_URL=https://t.me/tvoitrenerrf

# Channel bot bridge (skiinstruct/BOT_API.md)
BOT_API_SECRET=replace-with-long-random-secret
BOT_OUTBOUND_WEBHOOK_BASE_URL=http://channel-bot:8787
BOT_TOKEN=
CHANNEL_ID=@tvoitrenerrf

# Default admin account created on container start
SKIINSTRUCT_ADMIN_EMAIL=admin@qa.local
SKIINSTRUCT_ADMIN_PASSWORD=ChangeMe12345!
SKIINSTRUCT_ADMIN_NAME=QA Администратор
SKIINSTRUCT_MODERATOR_EMAIL=moderator@tvoytrener.ru
SKIINSTRUCT_MODERATOR_PASSWORD=ChangeMeModerator!
SKIINSTRUCT_MODERATOR_NAME=Модератор

# Optional integrations
SKIINSTRUCT_AUTH_GOOGLE_ID=
SKIINSTRUCT_AUTH_GOOGLE_SECRET=
SKIINSTRUCT_STRIPE_SECRET_KEY=
SKIINSTRUCT_STRIPE_WEBHOOK_SECRET=
# Web Push (заявки инструктору): docker run --rm node:20-alpine npx --yes web-push generate-vapid-keys
SKIINSTRUCT_VAPID_PUBLIC_KEY=
SKIINSTRUCT_VAPID_PRIVATE_KEY=
SKIINSTRUCT_VAPID_SUBJECT=mailto:noreply@твойтренер.рф

# Optional extra origins for server actions. Comma-separated host[:port] values.
SKIINSTRUCT_SERVER_ACTIONS_ALLOWED_ORIGINS=qa.example.com

# Сброс пароля (SMTP Beget)
SKIINSTRUCT_PASSWORD_RESET_DEBUG=0
SKIINSTRUCT_SMTP_HOST=smtp.beget.com
SKIINSTRUCT_SMTP_PORT=465
SKIINSTRUCT_SMTP_SECURE=1
SKIINSTRUCT_SMTP_USER=noreply@твойтренер.рф
SKIINSTRUCT_SMTP_PASSWORD=
SKIINSTRUCT_PASSWORD_RESET_EMAIL_FROM="ТвойТренер.рф <noreply@твойтренер.рф>"
SKIINSTRUCT_PASSWORD_RESET_EMAIL_SUBJECT="восстановление пароля на ТвойТренер.рф"

# Яндекс.Карты и геокодер на /client (ключ нужен при docker build — см. docker-compose.qa.yml)
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
# Яндекс.Метрика (вшивается в клиентский бандл при docker build)
NEXT_PUBLIC_YANDEX_METRIKA_ID=111110026
