# Скопируйте в .env в корне репозитория (рядом с docker-compose.yml).

JWT_SECRET=замените_на_случайную_строку_минимум_32_символа
PUBLIC_API_URL=http://localhost:3000
# Редирект после оплаты ЮKassa (legacy API): по умолчанию — веб‑приложение SkiInstruct
APP_RETURN_URL=http://localhost:3001/client/orders

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# 0 — реальная оплата; 1 — mock без ЮKassa (удобно на localhost без ключей)
ALLOW_MOCK_CHECKOUT=1
# 1 — блокировать ЮKassa-оплату без подтверждённого email (на VPS — 1)
REQUIRE_EMAIL_VERIFICATION=0
# 1 — проверять IP webhook ЮKassa (на VPS — 1)
YOOKASSA_WEBHOOK_VERIFY_IP=0
# На VPS за nginx/caddy: TRUSTED_PROXY_COUNT=1
# TRUSTED_PROXY_COUNT=
FCM_SERVER_KEY=

# SkiInstruct (docker-compose service on http://localhost:3001)
SKIINSTRUCT_DATABASE_URL=postgres://sky:sky@postgres:5432/skytrainer_new?schema=skiinstruct
SKIINSTRUCT_AUTH_SECRET=замените_на_случайную_строку_минимум_32_символа
SKIINSTRUCT_AUTH_URL=http://localhost:3001
SKIINSTRUCT_PUBLIC_APP_URL=http://localhost:3001
# Если открываете сайт с телефона по IP: добавьте хост:порт через запятую
# SKIINSTRUCT_SERVER_ACTIONS_ALLOWED_ORIGINS=192.168.1.10:3001
SKIINSTRUCT_CRON_SECRET=замените_на_случайную_строку_минимум_32_символа
SKIINSTRUCT_AUTH_GOOGLE_ID=
SKIINSTRUCT_AUTH_GOOGLE_SECRET=
SKIINSTRUCT_ADMIN_EMAIL=admin@skiinstruct.local
SKIINSTRUCT_ADMIN_PASSWORD=Admin12345!
SKIINSTRUCT_ADMIN_NAME=Главный администратор
SKIINSTRUCT_STRIPE_SECRET_KEY=
SKIINSTRUCT_STRIPE_WEBHOOK_SECRET=

# 0 — заявки попадают в /admin/moderation. 1 — сразу «Опубликовано» без админки (удобно для быстрых тестов)
SKIINSTRUCT_AUTO_APPROVE_EVENTS=0

# localhost:3001 — по умолчанию dev (hot-reload). prod = быстрый UI, но после каждой правки нужен rebuild.
SKIINSTRUCT_NEXT_MODE=dev
SKIINSTRUCT_USE_POLLING=1
# SKIINSTRUCT_NEXT_MODE=prod
# Не задавайте SKIINSTRUCT_NODE_ENV=production вместе с dev — ломает Tailwind (@tailwind в globals.css).
# SKIINSTRUCT_FORCE_REBUILD=1
# После правок агент/хук: .\scripts\refresh-skiinstruct-3001.ps1

SKIINSTRUCT_VAPID_PUBLIC_KEY=
SKIINSTRUCT_VAPID_PRIVATE_KEY=
SKIINSTRUCT_VAPID_SUBJECT=mailto:you@example.com

# Локально: 1 — кнопка сброса на странице без email; на VPS — 0
SKIINSTRUCT_PASSWORD_RESET_DEBUG=1
# Password reset by email — SMTP Beget (рекомендуется) или webhook
SKIINSTRUCT_SMTP_HOST=smtp.beget.com
SKIINSTRUCT_SMTP_PORT=465
SKIINSTRUCT_SMTP_SECURE=1
SKIINSTRUCT_SMTP_USER=noreply@utrainer.ru
SKIINSTRUCT_SMTP_PASSWORD=
SKIINSTRUCT_PASSWORD_RESET_EMAIL_FROM="uTrainer <noreply@utrainer.ru>"
SKIINSTRUCT_PASSWORD_RESET_EMAIL_SUBJECT="восстановление пароля на UTrainer"
# Альтернатива SMTP: POST JSON { to, from, subject, text, html }
# SKIINSTRUCT_PASSWORD_RESET_EMAIL_WEBHOOK_URL=

# --- Поддержка: веб-чат → MAX (сервис skiinstruct в Docker) ---
# Токен с https://dev.max.ru — НЕ коммитить, только в локальный .env
MAX_BOT_TOKEN=
# Личный чат с ботом: ваш user_id (см. skiinstruct/SUPPORT_SETUP.md)
MAX_SUPPORT_USER_ID=
# Или группа поддержки: chat_id (бот — администратор группы)
MAX_SUPPORT_CHAT_ID=
# Для ответов из MAX в веб-чат (нужен HTTPS): 5–256 символов A-Za-z0-9_-
MAX_WEBHOOK_SECRET=
NEXT_PUBLIC_SUPPORT_MAX_URL=https://max.ru/id110116757261_bot
NEXT_PUBLIC_SUPPORT_EMAIL=

# Яндекс.Карты и геокодер для /client (ключ JavaScript API + HTTP Геокодер)
# https://developer.tech.yandex.ru/ — см. skiinstruct/docs/YANDEX_MAPS.md
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
# Устаревший алиас (подхватывается автоматически, если NEXT_PUBLIC_* пуст):
# VITE_YANDEX_MAPS_API_KEY=
