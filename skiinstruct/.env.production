# Production (Next.js NODE_ENV=production + Docker: дублируйте в корневом .env на VPS)
NEXT_PUBLIC_APP_URL=http://твойтренер.рф
ALLOW_MOCK_CHECKOUT=0

# ЮKassa — shopId и secret_key только на сервере (не коммитьте боевые ключи)
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# Webhook в ЛК: http://твойтренер.рф/api/webhooks/yookassa
# TRUSTED_PROXY_COUNT=1
# Чеки: раздел «Чеки от ЮKassa» — включить
# NEXT_PUBLIC_LEGAL_ENTITY_NAME=ИП Ершов Андрей Валерьевич
# Аналитика (счётчик подключается после «Принять» в баннере cookies)
NEXT_PUBLIC_YANDEX_METRIKA_ID=110019328
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX
YOOKASSA_WEBHOOK_VERIFY_IP=1
