# Production (Next.js NODE_ENV=production + Docker: дублируйте в корневом .env на VPS)
NEXT_PUBLIC_APP_URL=https://твойтренер.рф
ALLOW_MOCK_CHECKOUT=0

# ЮKassa — shopId и secret_key только на сервере (не коммитьте боевые ключи)
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# Webhook в ЛК: https://твойтренер.рф/api/webhooks/yookassa
# TRUSTED_PROXY_COUNT=1
# Чеки: раздел «Чеки от ЮKassa» — включить
# NEXT_PUBLIC_LEGAL_ENTITY_NAME=ООО «ТВОЙТРЕНЕР»
# Аналитика (счётчик подключается после «Принять» в баннере cookies)
NEXT_PUBLIC_YANDEX_METRIKA_ID=110595574
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX
YOOKASSA_WEBHOOK_VERIFY_IP=1
SEO_SAME_AS=https://yandex.ru/maps/org/tvoytrener/126603086476/,https://t.me/tvoitrenerrf
NEXT_PUBLIC_SUPPORT_EMAIL=tvoitrenerrf@yandex.ru
