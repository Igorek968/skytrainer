# Database (Supabase PostgreSQL connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Auth.js / NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-random-string"
# Base URL of the app (no trailing slash). Должен совпадать с тем, что в адресной строке (localhost ≠ 127.0.0.1, порт как у dev-сервера).
AUTH_URL="http://localhost:3000"
# Должен совпадать с адресом в браузере. Клиентский next-auth берёт NEXTAUTH_URL — если не задан, в next.config он копируется из AUTH_URL при сборке.
NEXTAUTH_SECRET="same-as-auth-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional — omit to disable Google login button flows)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Public URL for redirects (Stripe success/cancel)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Аналитика (подключается после согласия на cookies)
# NEXT_PUBLIC_YANDEX_METRIKA_ID=110595574
# NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# Отображаемое имя продукта в админке (по умолчанию ТвойТренер.рф)
# NEXT_PUBLIC_APP_NAME="ТвойТренер.рф"
# Полное наименование исполнителя для публичной оферты (/oferta)
# NEXT_PUBLIC_LEGAL_ENTITY_NAME="ООО «…», ИНН …"
# Юридический адрес ИП в оферте и политике ПДн (если не задан — адрес из legal-entity.ts)
# NEXT_PUBLIC_LEGAL_ADDRESS="167000, Республика Коми, г. Сыктывкар, ул. Коммунистическая, д. 85, кв. 3"

# Stripe test keys — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Protect cron endpoints (Bearer or ?secret=): expire-orders, lesson-reminders
# lesson-reminders: резерв, если встроенный планировщик выключен
CRON_SECRET="replace-with-random-string"
# 1 (по умолчанию в Docker prod) — push за ~1 ч до урока/мероприятия без внешнего cron
# SKIINSTRUCT_INTERNAL_SCHEDULER=1

# Web Push (optional — leave empty to rely on Sonner toasts only)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Password reset — SMTP (Beget: smtp.beget.com, порт 465) или webhook
SMTP_HOST=smtp.beget.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=noreply@твойтренер.рф
SMTP_PASSWORD=
PASSWORD_RESET_EMAIL_FROM="ТвойТренер.рф <noreply@твойтренер.рф>"
PASSWORD_RESET_EMAIL_SUBJECT="восстановление пароля на ТвойТренер.рф"
# PASSWORD_RESET_EMAIL_WEBHOOK_URL=""

# Локальный «next start» без AUTH_SECRET: задайте AUTH_URL/NEXTAUTH_URL как в браузере (localhost ≠ 127.0.0.1)
# или временно SKIINSTRUCT_AUTH_DEV_FALLBACK=1 (только на своей машине, не на публичном проде).
# SKIINSTRUCT_AUTH_DEV_FALLBACK=1

# Поддержка платформы (веб-чат + MAX)
# MAX_BOT_TOKEN=""                # токен с https://dev.max.ru
# MAX_SUPPORT_USER_ID=""          # ваш user_id (личный чат с ботом)
# MAX_SUPPORT_CHAT_ID=""          # id группы (альтернатива user_id)
# MAX_WEBHOOK_SECRET=""           # секрет для POST /api/webhooks/max
# NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"
# NEXT_PUBLIC_SUPPORT_MAX_URL="https://max.ru/id110116757261_bot"

# Платежи (см. PAYMENTS_YOOKASSA.md)
# STRIPE_SECRET_KEY="" / STRIPE_WEBHOOK_SECRET=""
# YOOKASSA_SHOP_ID="" / YOOKASSA_SECRET_KEY=""
# Webhook в ЛК ЮKassa: https://твойтренер.рф/api/webhooks/yookassa
# YOOKASSA_WEBHOOK_VERIFY_IP=1  — проверка IP webhook (на VPS — 1)
# ALLOW_MOCK_CHECKOUT=0  — на VPS; 1 — локально без ключей ЮKassa
# TRUSTED_PROXY_COUNT=1  — за reverse proxy на VPS
# NEXT_PUBLIC_LEGAL_ENTITY_NAME="ИП …"
# NEXT_PUBLIC_LEGAL_ADDRESS="167000, Республика Коми, г. Сыктывкар, ул. Коммунистическая, д. 85, кв. 3"
# Рег. номер уведомления Роскомнадзора (после подачи)
# NEXT_PUBLIC_PDN_REGISTRY_NUMBER=""

# Google Play (TWA) — после `bubblewrap build` в android-twa/
# ANDROID_PACKAGE_NAME=ru.tvoytrener.app
# ANDROID_SHA256_FINGERPRINTS=AA:BB:CC:...   # bubblewrap fingerprint list; несколько — через запятую
# Проверка: https://ваш-домен/.well-known/assetlinks.json

# Email: подтверждение при регистрации (SMTP как для сброса пароля)
# REQUIRE_EMAIL_VERIFICATION=1  — блокировать ЮKassa-оплату без emailVerified

# Google OAuth (кнопка на /login)
# AUTH_GOOGLE_ID="" / AUTH_GOOGLE_SECRET=""

# IndexNow (Яндекс / Bing): ключ должен совпадать с public/{KEY}.txt
# INDEXNOW_KEY=4ca507ae0d53f067978dd6277e88a6d3
# Уведомление: GET/POST /api/cron/indexnow с Bearer CRON_SECRET
# Или с хоста: .\scripts\submit-indexnow.ps1

# Внешние профили бренда для Organization.sameAs (через запятую):
# Яндекс.Бизнес, 2ГИС, VK, Telegram, Instagram и т.п.
# SEO_SAME_AS=https://yandex.ru/maps/org/...,https://t.me/...
