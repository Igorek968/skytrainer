// SkiInstruct — PostgreSQL schema (Supabase / Vercel compatible)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  INSTRUCTOR
  ADMIN
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LessonDuration {
  ONE_HOUR
  TWO_HOURS
  HALF_DAY
  FULL_DAY
}

enum OrderStatus {
  DRAFT
  AWAITING_PAYMENT
  PENDING_INSTRUCTOR
  ACCEPTED
  INSTRUCTOR_EN_ROUTE
  LESSON_STARTED
  COMPLETED
  CANCELLED
  REJECTED
  EXPIRED
}

enum PaymentMethod {
  CARD
  CASH
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum InstructorVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InstructorProfileDraftStatus {
  NONE
  PENDING_REVIEW
}

enum RefundStatus {
  NONE
  PENDING
  COMPLETED
  FAILED
  NOT_APPLICABLE
}

enum OrderCancelledBy {
  CLIENT
  INSTRUCTOR
  PLATFORM
  SYSTEM
}

enum ComplianceDocType {
  TAX_STATUS_NPD
  TAX_STATUS_IP
  INSURANCE
}

enum ComplianceDocStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InstructorTaxStatus {
  SELF_EMPLOYED
  IP
}

enum InstructorEventModerationStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum EventRegistrationStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
}

enum PayoutRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}

// Auth.js / NextAuth models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  /// Нормализованный российский мобильный, 11 цифр с ведущей 7 (уникален для клиентов с телефоном)
  phone         String?   @unique
  emailVerified DateTime?
  image         String?

  passwordHash String?

  /// Дата рождения (для личных данных клиента / учётной записи)
  birthDate DateTime?

  role UserRole @default(CLIENT)

  accounts Account[]
  sessions Session[]

  instructorProfile InstructorProfile?

  clientOrders     Order[] @relation("ClientOrders")
  instructorOrders Order[] @relation("InstructorOrders")

  sentMessages Message[] @relation("SentMessages")

  supportTickets SupportTicket[]

  pushSubscriptions PushSubscription[]

  passwordResetTokens PasswordResetToken[]

  complianceDocuments InstructorComplianceDocument[]
  instructorEvents      InstructorEvent[]
  instructorEventTitles InstructorEventTitle[]
  eventRegistrations    EventRegistration[]
  payoutRequests        InstructorPayoutRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Password reset tokens for credentials-based users (email request -> token link -> set new password).
/// Token is stored as SHA-256 hash, raw token is only ever sent to the user (e.g. in a link).
model PasswordResetToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the raw token.
  tokenHash String @unique

  createdAt DateTime @default(now())
  expiresAt DateTime
  usedAt    DateTime?
}

/// Одноразовый код входа по телефону (SMS). Одна активная запись на номер.
model PhoneOtpChallenge {
  id          String   @id @default(cuid())
  phoneNorm   String   @unique
  /// SHA-256 hex от секрета и кода (см. lib/phone-otp.ts)
  codeHash    String
  pendingName String?
  expiresAt   DateTime
  verifyAttempts Int   @default(0)
  createdAt   DateTime @default(now())
}

model Resort {
  id        String @id @default(cuid())
  name      String
  slug      String @unique
  country   String?
  centerLat Float
  centerLng Float
  zoom      Int    @default(13)

  instructors InstructorProfile[]
  orders      Order[]
}

model InstructorProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio                String? @db.Text
  certificationLevel String?
  certifications     String[] @default([])
  skillLevels        String[] @default([])
  languages          String[]
  hourlyRate         Decimal @db.Decimal(10, 2)
  photoUrl           String?
  photoGallery       String[] @default([])
  age                    Int?
  experienceYears        Int?
  sportsExperienceYears  Int?
  totalLessons           Int?
  achievements       String[] @default([])

  /// Last known position (Geolocation API, max ~1 req / 30s from client)
  lat Float?
  lng Float?

  isOnline           Boolean                      @default(false)
  verificationStatus InstructorVerificationStatus @default(PENDING)
  /// Черновик анкеты до одобрения администратором (для одобренных инструкторов).
  profileDraft           Json?
  profileDraftStatus     InstructorProfileDraftStatus @default(NONE)
  profileDraftSubmittedAt DateTime?
  /// Комментарий администратора при отклонении черновика или первичной анкеты.
  profileDraftRejectNote   String?   @db.Text
  profileDraftRejectedAt   DateTime?
  specializations    String[]
  /// Направления с ценой и счётчиком занятий: [{ label, hourlyRate, lessonsCompleted }]
  specializationOffers Json?
  additionalServices String[] @default([])
  offeredDurations   String[] @default([])
  availabilitySlots  Json?
  cancellationPolicy String? @db.Text
  supportContact     String?
  legalInfo          String?

  /// Акцепт агентской оферты для инструкторов (/oferta-instructor).
  agencyOfferAcceptedAt DateTime?
  agencyOfferVersion    String? @default("2026-05-13")
  taxStatus             InstructorTaxStatus?
  inn                   String?
  /// Маскированные реквизиты для выплат (карта/счёт).
  payoutAccountHint     String?

  telegramUrl String?
  whatsappUrl String?
  instagramUrl String?
  videoVisitUrl String?

  ratingAvg   Float @default(0)
  reviewCount Int   @default(0)

  resortId String?
  resort   Resort? @relation(fields: [resortId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id String @id @default(cuid())

  clientId String
  client   User   @relation("ClientOrders", fields: [clientId], references: [id], onDelete: Cascade)

  instructorId String?
  instructor   User?   @relation("InstructorOrders", fields: [instructorId], references: [id], onDelete: SetNull)

  resortId String?
  resort   Resort? @relation(fields: [resortId], references: [id])

  status OrderStatus @default(DRAFT)

  meetLat Float
  meetLng Float
  /// Адрес / описание места встречи от клиента (обязательно для принятия заявки).
  meetAddress String? @db.VarChar(500)

  skillLevel    SkillLevel
  languagePref  String
  duration      LessonDuration
  /// Каноническое направление из поиска клиента (🎿 Горные лыжи и т.д.)
  disciplineLabel String?
  notes         String?        @db.Text
  requestedStartDate DateTime?
  requestedEndDate   DateTime?
  requestedDays      Int?

  instructorQueue    Json?
  instructorQueueIndex Int      @default(0)

  /// Запись на дату: инструктор мог быть офлайн; без дедлайна ответа.
  flexibleInstructorInvite Boolean @default(false)

  /// Срочный вызов: инструктор на линии, ограниченное время на принятие после оплаты.
  urgentInvite Boolean @default(false)

  /// Instructor must accept within this window (UTC), только для urgentInvite.
  pendingExpiresAt DateTime?

  acceptedAt      DateTime?
  /// Момент ожидаемого прибытия инструктора (now + ETA при принятии / обновлении ETA).
  instructorEtaAt DateTime?
  lessonStartedAt DateTime?
  lessonEndedAt   DateTime?

  /// Web Push: напоминание «за ~1 мин до начала» (по requestedStartDate) уже отправлено.
  lessonStartReminderSentAt DateTime?
  /// Web Push: напоминание завершить урок по плановому окончанию уже отправлено.
  lessonEndReminderSentAt DateTime?

  /// После «урок выполнен»: доля инструктора (за вычетом комиссии платформы) считается переданной учётно.
  instructorPayoutReleasedAt DateTime?
  /// С какого момента доля доступна к выплате (подтверждение + срок из оферты).
  payoutEligibleAt DateTime?
  /// Фактическая выплата инструктору (после обработки заявки админом).
  instructorPayoutPaidAt DateTime?
  payoutRequestId String?
  payoutRequest   InstructorPayoutRequest? @relation(fields: [payoutRequestId], references: [id], onDelete: SetNull)

  cancelledBy     OrderCancelledBy?
  refundPercent   Int?
  refundAmount    Decimal? @db.Decimal(10, 2)
  refundStatus    RefundStatus @default(NONE)
  refundNote      String? @db.Text
  lateRefundClaimedAt DateTime?

  npdReceiptUrl         String?
  npdReceiptUploadedAt  DateTime?

  clientRating Int?
  clientReview String? @db.Text
  instructorRating Int?
  instructorReview String? @db.Text

  agreedHourlyRate Decimal? @db.Decimal(10, 2)

  paymentMethod PaymentMethod?
  paymentStatus PaymentStatus  @default(PENDING)

  stripeCheckoutSessionId String?
  stripePaymentIntentId     String?
  yookassaPaymentId         String? @unique

  /// Total charged to client (platform + instructor share)
  amountTotal Decimal? @db.Decimal(10, 2)

  platformFeePercent    Int      @default(15)
  instructorShareAmount Decimal? @db.Decimal(10, 2)

  messages Message[]
  payments Payment[]
  events   InstructorEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([instructorId])
  @@index([status])
}

/// Каталог названий мероприятий инструктора (для выбора из уже созданных).
model InstructorEventTitle {
  id           String @id @default(cuid())
  instructorId String
  instructor   User   @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  title        String
  events       InstructorEvent[]

  createdAt DateTime @default(now())

  @@unique([instructorId, title])
  @@index([instructorId])
}

/// Мероприятия / объявления инструктора (лента на странице заказа).
model InstructorEvent {
  id           String @id @default(cuid())
  instructorId String
  instructor   User   @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  titleId String?
  titleRef InstructorEventTitle? @relation(fields: [titleId], references: [id], onDelete: SetNull)

  /// Если задан — видно только на этом заказе; иначе на всех заказах с этим инструктором.
  orderId String?
  order   Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  title   String
  body    String @db.Text
  /// Обложка мероприятия для ленты клиентов.
  photoUrl String?
  eventAt DateTime?

  moderationStatus InstructorEventModerationStatus @default(DRAFT)
  rejectNote       String? @db.Text
  submittedAt      DateTime?
  publishedAt      DateTime?

  /// Стоимость участия в рублях; null или 0 — бесплатная запись.
  priceRub Int?
  /// Лимит оплаченных мест; null — без лимита (legacy, если нет слотов).
  maxRegistrations Int?

  slots         EventSlot[]
  registrations EventRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([instructorId, moderationStatus, createdAt])
  @@index([titleId])
  @@index([orderId])
}

/// Выход мероприятия (время, цена, лимит мест).
model EventSlot {
  id      String          @id @default(cuid())
  eventId String
  event   InstructorEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  startsAt  DateTime
  maxSeats  Int?
  priceRub  Int?
  sortOrder Int      @default(0)

  registrations EventRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, startsAt])
}

/// Запись клиента на мероприятие инструктора.
model EventRegistration {
  id       String @id @default(cuid())
  eventId  String
  event    InstructorEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  clientId String
  client   User   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  slotId String?
  slot   EventSlot? @relation(fields: [slotId], references: [id], onDelete: Cascade)

  /// slotId или `${eventId}:${clientId}` для записей без слота
  registrationKey String? @unique

  status EventRegistrationStatus @default(PENDING_PAYMENT)

  amountRub             Decimal  @db.Decimal(10, 2)
  platformFeePercent    Int      @default(15)
  instructorShareAmount Decimal? @db.Decimal(10, 2)

  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  yookassaPaymentId       String? @unique
  paidAt                  DateTime?

  /// Клиент подтвердил участие после окончания мероприятия.
  attendanceConfirmedAt   DateTime?
  attendanceReminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId, status])
  @@index([slotId, status])
  @@index([clientId])
}

model Message {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  body String @db.Text

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

/// Заявка инструктора на вывод заработанной доли.
model InstructorPayoutRequest {
  id           String @id @default(cuid())
  instructorId String
  instructor   User   @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  amountRub   Decimal @db.Decimal(10, 2)
  status      PayoutRequestStatus @default(PENDING)
  adminNote   String? @db.Text
  processedAt DateTime?

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([instructorId, status])
}

model Payment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  stripePaymentIntentId String?
  yookassaPaymentId     String?
  amount                Decimal  @db.Decimal(10, 2)
  currency              String   @default("rub")
  status                PaymentStatus

  createdAt DateTime @default(now())
}

/// Документы инструктора: НПД/ИП, страхование (модерация админом).
model InstructorComplianceDocument {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type       ComplianceDocType
  fileUrl    String
  status     ComplianceDocStatus @default(PENDING)
  rejectNote String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, type])
}

enum SupportAuthorRole {
  USER
  STAFF
  SYSTEM
}

/// Обращение в поддержку платформы (не путать с чатом заказа).
model SupportTicket {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  guestEmail String?
  guestName  String?

  /// Токен для гостя (cookie) — доступ к API без входа.
  accessToken String @unique @default(cuid())

  status String @default("OPEN")

  messages SupportMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([accessToken])
}

model SupportMessage {
  id       String @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorRole SupportAuthorRole
  body       String          @db.Text

  /// ID сообщения в Telegram (для ответа reply_to).
  telegramMessageId BigInt?

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([telegramMessageId])
}

model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String @unique
  p256dh   String
  auth     String

  createdAt DateTime @default(now())
}
