{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Docker Compose: up (DB + skiinstruct)",
      "type": "shell",
      "command": "cmd.exe",
      "args": [
        "/c",
        "docker compose -f docker-compose.yml up -d --build postgres redis skiinstruct"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Docker Compose: up (включая legacy api)",
      "type": "shell",
      "command": "cmd.exe",
      "args": [
        "/c",
        "docker compose --profile with-api -f docker-compose.yml up -d --build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
